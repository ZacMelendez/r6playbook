# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis — rate limiting for writes
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google reCAPTCHA v2 — protects strategy and feedback submissions
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cloudinary — image hosting for strategy screenshots
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email of the account that sees admin-only menu items
NEXT_PUBLIC_ADMIN_EMAIL=

# Google OAuth — used by the local Supabase stack (supabase/config.toml)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
